#define IDI_RALGRUM 1
IDI_RALGRUM ICON "@ICON_PATH@"

1 VERSIONINFO
FILEVERSION @VERSION_NUMBERS@
PRODUCTVERSION @VERSION_NUMBERS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "ralgruM\0"
            VALUE "FileVersion", "@VERSION_STRING@\0"
            VALUE "InternalName", "ralgruM\0"
            VALUE "OriginalFilename", "ralgruM.exe\0"
            VALUE "ProductName", "ralgruM\0"
            VALUE "ProductVersion", "@VERSION_STRING@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
